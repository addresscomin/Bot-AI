# Public client values (safe only with RLS enabled)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never expose these in Android/web builds.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Media provider configuration (server-side only)
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_BUCKET=zeekdrop-media
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_CDN_BASE_URL=

# Operational settings
APP_ENV=development
PORT=8080
